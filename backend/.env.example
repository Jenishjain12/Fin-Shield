# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL  (required on Render — set in Render dashboard, NOT here)
# ─────────────────────────────────────────────────────────────────────────────

# For local development (SQLite – ephemeral, for testing only):
# DATABASE_URL=sqlite:////tmp/finshield.db

# For Render production (PostgreSQL – use the Internal Database URL from your
# Render Postgres service, available under "Connect" in the Render dashboard):
# DATABASE_URL=postgresql://user:password@dpg-xxx.oregon-postgres.render.com/finshield

# For Vercel / other PostgreSQL providers (e.g. Neon):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SIMILARITY_THRESHOLD=0.72

# Writable scratch space (works on Render, Vercel serverless, and locally)
UPLOAD_DIR=/tmp/finshield_uploads
